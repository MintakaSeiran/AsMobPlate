<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
  </PropertyGroup>
  <Target Name="ReadPluginVersion" BeforeTargets="GetAssemblyVersion">
    <XmlPeek XmlInputPath="../../AsMobPlate.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="Version" />
    </XmlPeek>
  </Target>
  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)/Dalamud.dll" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)/FFXIVClientStructs.dll" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)/InteropGenerator.Runtime.dll" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)/Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)/Lumina.Excel.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll" />
    <Content Include="$(DalamudLibPath)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../../Hunts/HuntRank.cs" Link="HuntRank.cs" />
    <Compile Include="../../Localization/UiText.cs" Link="UiText.cs" />
    <Compile Include="../../Overlay/NameplatePainter.cs" Link="NameplatePainter.cs" />
    <Compile Include="../../Overlay/ArrivalEstimator.cs" Link="ArrivalEstimator.cs" />
    <Compile Include="../../Overlay/DebugLog.cs" Link="DebugLog.cs" />
    <Compile Include="../../Overlay/PartyFinderRecruitment.cs" Link="PartyFinderRecruitment.cs" />
    <Compile Include="../../Overlay/RecruitmentComment.cs" Link="RecruitmentComment.cs" />
    <Compile Include="../../Windows/NameplatePreview.cs" Link="NameplatePreview.cs" />
    <Compile Include="../../Windows/PreviewAnimation.cs" Link="PreviewAnimation.cs" />
    <Compile Include="../../Windows/ConfigWindow.cs" Link="ConfigWindow.cs" />
  </ItemGroup>
</Project>
